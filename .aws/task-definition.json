{
  "family": "shifatech-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::708623999432:role/ecsTaskExecutionRole",

  "containerDefinitions": [

    {
      "name": "admin-service",
      "image": "public.ecr.aws/docker/library/alpine:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8000 }],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "ADMIN_DB_HOST", "value": "shifatech.czis260owi0q.eu-north-1.rds.amazonaws.com" },
        { "name": "ADMIN_DB_PORT", "value": "3306" },
        { "name": "ADMIN_DB_NAME", "value": "admindb" },
        { "name": "ADMIN_DB_USER", "value": "admin" }
      ],
      "secrets": [
        {
          "name": "ADMIN_DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:708623999432:secret:shifatech/rds-password-NypArb"
        }
      ]
    },

    {
      "name": "auth-service",
      "image": "public.ecr.aws/docker/library/alpine:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8080 }],
