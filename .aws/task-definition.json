{
  "family": "shifatech-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::708623999432:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "admin-service",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [{ "containerPort": 8000 }]
    },
    {
      "name": "auth-service",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [{ "containerPort": 8080 }]
    },
    {
      "name": "body-service",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [{ "containerPort": 9000 }]
    },
    {
      "name": "web-service",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [{ "containerPort": 4200 }]
    }
  ]
}