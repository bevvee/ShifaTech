{
    "info": {
        "_postman_id": "shifatech-gateway-tests-full",
        "name": "ShifaTech - Doctor Service Full API (DIRECT v3)",
        "description": "Collection complète : accès direct via Nginx (8082). Inclus : AUTH (Register/Login), Profil Docteur, Spécialités, Planning, Patients, Ordonnances.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "0. AUTH",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"nom\": \"Admin\",\n    \"prenom\": \"User\",\n    \"cin\": \"A1234567\",\n    \"email\": \"admin@gmail.com\",\n    \"password\": \"Password123\",\n    \"passwordConfirmation\": \"Password123\",\n    \"role\": \"ADMIN\",\n    \"sexe\": \"M\",\n    \"dateNaissance\": \"1990-01-01\",\n    \"telephone\": \"0612345678\",\n    \"adresse\": \"123 Main St\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8082/auth/register",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8082",
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.accessToken || jsonData.token) {",
                                    "    pm.collectionVariables.set(\"jwt_token\", jsonData.accessToken || jsonData.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@gmail.com\",\n    \"password\": \"Password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8082/auth/login",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8082",
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Profile (Me)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8082/auth/profile",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8082",
                            "path": [
                                "auth",
                                "profile"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
