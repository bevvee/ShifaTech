{
    "info": {
        "_postman_id": "shifatech-gateway-tests",
        "name": "ShifaTech - Doctor Service Full API (DIRECT v2)",
        "description": "Collection complète corrigée : accès direct via Nginx (8082). Inclus : Profil Docteur, Planning, Patients, RDV.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "0. AUTH",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.accessToken) {",
                                    "    pm.collectionVariables.set(\"jwt_token\", jsonData.accessToken);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@gmail.com\",\n    \"password\": \"Password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "http://localhost:8082/auth/login"
                    }
                }
            ]
        },
        {
            "name": "1. DOCTOR PROFILE",
            "item": [
                {
                    "name": "List All Doctors",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/doctor/all"
                    }
                },
                {
                    "name": "Get Doctor By ID",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/doctor/1"
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PUT",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"numeroOrdre\": \"ORD-2026-X\",\n    \"idSpecialite\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "http://localhost:8082/doctor/1"
                    }
                }
            ]
        },
        {
            "name": "2. PLANNING (Doctor Availability)",
            "item": [
                {
                    "name": "Get Planning by DoctorID",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/doctor/planning/1"
                    }
                },
                {
                    "name": "Create Planning Slot",
                    "request": {
                        "method": "POST",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"idDoctor\": 1,\n    \"jour\": \"LUNDI\",\n    \"heureDebut\": \"09:00:00\",\n    \"heureFin\": \"17:00:00\",\n    \"pauseDebut\": \"12:00:00\",\n    \"pauseFin\": \"13:00:00\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "http://localhost:8082/doctor/planning"
                    }
                }
            ]
        },
        {
            "name": "3. PATIENTS (DIRECT)",
            "item": [
                {
                    "name": "List All Patients",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/patient/"
                    }
                },
                {
                    "name": "Get Patient Dossier Medical",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/patient/1/dossier-medical"
                    }
                },
                {
                    "name": "Create Ordonnance",
                    "request": {
                        "method": "POST",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"idPatient\": 1,\n    \"medicaments\": \"Doliprane\",\n    \"posologie\": \"1g x 3\",\n    \"dureeTraitement\": \"5 jours\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "http://localhost:8082/patient/ordonnances"
                    }
                }
            ]
        },
        {
            "name": "4. RDV (DIRECT)",
            "item": [
                {
                    "name": "List All RDVs",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/rdv/api/rendez/vous"
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "jwt_token",
            "value": "token_here",
            "type": "string"
        }
    ]
}