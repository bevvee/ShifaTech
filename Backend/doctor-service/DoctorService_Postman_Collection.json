                            "raw": "{\n    \"idPatient\": 1,\n    \"idDocteur\": 1,\n    \"dateConsultation\": \"2025-12-28\",\n    \"observations\": \"Patient en bonne santé.\",\n    \"diagnostic\": \"RAS\"\n}",
                            "options": {
